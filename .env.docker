# PostgreSQL Configuration
POSTGRES_DB=classpod
POSTGRES_USER=classpod
POSTGRES_PASSWORD=classpod
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6379

# Service Discovery & Ports
API_PORT=4000
AI_DETECTION_PORT=5000
WEB_PORT=3000

# Security Secrets
GATEWAY_SHARED_SECRET=local-dev-secret-key
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long

# Storage Configuration (local or s3)
STORAGE_DRIVER=local
