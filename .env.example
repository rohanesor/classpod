NODE_ENV=development
LOG_LEVEL=info
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=classpod
POSTGRES_USER=classpod
POSTGRES_PASSWORD=classpod
DATABASE_URL=postgresql://classpod:classpod@localhost:5432/classpod?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
GATEWAY_SHARED_SECRET=replace-me-with-secret
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=1d
